# Public site URL (used for SEO canonical, sitemap, OG). Set to the final domain.
NEXT_PUBLIC_SITE_URL=https://elel-joypurhat.vercel.app

# Admin bootstrap account (never commit real values; set these in Vercel env).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=ELeL Joypurhat Admin
# Generate with: node apps/web/scripts/hash-password.mjs "YourStrongPassw0rd!"
ADMIN_PASSWORD_HASH=pbkdf2$iterations$salt$hash
ADMIN_RECOVERY_TOKEN=replace-with-private-owner-recovery-code
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Neon/Postgres connection string. Without it the CMS still serves the bundled
# seed (reads), but admin edits will not persist on serverless. Required for
# durable production data. After setting it, run: npm run db:seed (in apps/web).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional providers (CMS works without them; only automated sending is disabled).
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_API_KEY=
